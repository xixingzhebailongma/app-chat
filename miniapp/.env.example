# 复制为 .env（本地）或 .env.production（生产）后按需填写；真值不入库。

# —— 本地 mock 预览（默认，无需后端/微信，直接 npm run dev:h5）——
VITE_USE_MOCK=true
VITE_BASE_URL=http://127.0.0.1:8080

# —— 真实模式（真机/生产）——
# VITE_USE_MOCK=false
# VITE_BASE_URL=https://<网关域名>
# VITE_WS_BASE_URL=wss://<网关域名>
# VITE_SUBSCRIBE_TMPL_IDS=tmpl_device_offline,tmpl_sensor_threshold,tmpl_face_login_failed
