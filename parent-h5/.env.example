# 复制为 .env（本地）/ .env.production（生产）后按需填写；真值不入库。
# 默认 USE_MOCK=false（真实 OA 后端）；本地 mock 由 .env.development 显式开启。

# —— 本地 mock（.env.development 已默认 VITE_USE_MOCK=true，直接 npm run dev）——
# VITE_USE_MOCK=true
# VITE_DEV_SMS_CODE=123456

# —— 真实模式（公众号网页授权；生产构建必须 VITE_USE_MOCK=false，否则构建失败）——
VITE_USE_MOCK=false
# VITE_OA_BASE_URL=<OA 网关地址；留空=同域/走 vite proxy>
# VITE_OA_APPID=<公众号 appid>
# VITE_OA_REDIRECT_URI=<网页授权回调地址（默认当前页 URL，可留空）>
