{
  "easycom": {
    "autoscan": true
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": { "navigationStyle": "custom" }
    },
    {
      "path": "pages/login/login",
      "style": { "navigationStyle": "custom" }
    },
    {
      "path": "pages/shell/shell",
      "style": {
        "navigationBarTitleText": "智慧教室",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark"
      }
    },
    {
      "path": "pages/alarm/detail",
      "style": { "navigationBarTitleText": "告警详情" }
    },
    {
      "path": "pages/admin/classroom-detail",
      "style": { "navigationBarTitleText": "教室详情", "enablePullDownRefresh": true }
    },
    {
      "path": "pages/admin/history",
      "style": { "navigationBarTitleText": "告警历史" }
    },
    {
      "path": "pages/admin/users",
      "style": { "navigationBarTitleText": "用户管理" }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "智慧教室",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F2F2F7",
    "backgroundColorTop": "#FFFFFF",
    "backgroundColorBottom": "#F2F2F7",
    "backgroundTextStyle": "dark"
  }
}
